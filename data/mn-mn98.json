[{"id":"mn98","segs":[{"i":"mn98:0.1","p":"Majjhima Nikāya 98","e":"Middle Discourses 98","s":"H","l":""},{"i":"mn98:0.2","p":"Vāseṭṭhasutta","e":"With Vāseṭṭha","s":"H","l":""},{"i":"mn98:1.1","p":"Evaṁ me sutaṁ—","e":"So I have heard.","r":"sya13.641","s":"N","l":""},{"i":"mn98:1.2","p":"ekaṁ samayaṁ bhagavā icchānaṅgale viharati icchānaṅgalavanasaṇḍe.","e":"At one time the Buddha was staying in a forest near Icchānaṅgala.","s":"N","l":""},{"i":"mn98:2.1","p":"Tena kho pana samayena sambahulā abhiññātā abhiññātā brāhmaṇamahāsālā icchānaṅgale paṭivasanti, seyyathidaṁ—","e":"Now at that time several very well-known well-to-do brahmins were residing in Icchānaṅgala. They included","s":"N","l":""},{"i":"mn98:2.2","p":"caṅkī brāhmaṇo, tārukkho brāhmaṇo, pokkharasāti brāhmaṇo, jāṇussoṇi brāhmaṇo, todeyyo brāhmaṇo, aññe ca abhiññātā abhiññātā brāhmaṇamahāsālā.","e":"the brahmins Caṅkī, Tārukkha, Pokkharasāti, Jānussoṇi, Todeyya, and others.","s":"N","l":""},{"i":"mn98:3.1","p":"Atha kho vāseṭṭhabhāradvājānaṁ māṇavānaṁ jaṅghāvihāraṁ anucaṅkamantānaṁ anuvicarantānaṁ ayamantarākathā udapādi:","e":"Then as the students Vāseṭṭha and Bhāradvāja were going for a walk they began to discuss the question:","s":"N","l":""},{"i":"mn98:3.2","p":"“kathaṁ, bho, brāhmaṇo hotī”ti?","e":"“How do you become a brahmin?”","s":"Vāseṭṭhabhāradvājānaṁ māṇavānaṁ","l":""},{"i":"mn98:3.3","p":"Bhāradvājo māṇavo evamāha:","e":"Bhāradvāja said this:","s":"N","l":""},{"i":"mn98:3.4","p":"“yato kho, bho, ubhato sujāto mātito ca pitito ca saṁsuddhagahaṇiko yāva sattamā pitāmahayugā akkhitto anupakkuṭṭho jātivādena—","e":"“When you’re well born on both your mother’s and father’s side, stemming from a clean vessel, with irrefutable and impeccable genealogy back to the seventh paternal generation—","s":"Bhāradvāja","l":""},{"i":"mn98:3.5","p":"ettāvatā kho, bho, brāhmaṇo hotī”ti.","e":"then you’re a brahmin.”","s":"Bhāradvāja","l":""},{"i":"mn98:3.6","p":"Vāseṭṭho māṇavo evamāha:","e":"Vāseṭṭha said this:","s":"N","l":""},{"i":"mn98:3.7","p":"“yato kho, bho, sīlavā ca hoti vattasampanno ca—","e":"“When you’re ethical and accomplished in doing your duties—","s":"Vāseṭṭha","l":""},{"i":"mn98:3.8","p":"ettāvatā kho, bho, brāhmaṇo hotī”ti.","e":"then you’re a brahmin.”","s":"Vāseṭṭha","l":""},{"i":"mn98:4.1","p":"Neva kho asakkhi bhāradvājo māṇavo vāseṭṭhaṁ māṇavaṁ saññāpetuṁ, na pana asakkhi vāseṭṭho māṇavo bhāradvājaṁ māṇavaṁ saññāpetuṁ.","e":"But neither was able to persuade the other.","s":"N","l":""},{"i":"mn98:5.1","p":"Atha kho vāseṭṭho māṇavo bhāradvājaṁ māṇavaṁ āmantesi:","e":"So Vāseṭṭha said to Bhāradvāja,","r":"sya13.642","s":"N","l":""},{"i":"mn98:5.2","p":"“ayaṁ kho, bho bhāradvāja, samaṇo gotamo sakyaputto sakyakulā pabbajito icchānaṅgale viharati icchānaṅgalavanasaṇḍe.","e":"“Worthy Bhāradvāja, the ascetic Gotama—a Sakyan, gone forth from a Sakyan family—is staying in a forest near Icchānaṅgala.","s":"Vāseṭṭha","l":""},{"i":"mn98:5.3","p":"Taṁ kho pana bhavantaṁ gotamaṁ evaṁ kalyāṇo kittisaddo abbhuggato:","e":"He has this good reputation:","s":"Vāseṭṭha","l":""},{"i":"mn98:5.4","p":"‘itipi so bhagavā arahaṁ sammāsambuddho vijjācaraṇasampanno sugato lokavidū anuttaro purisadammasārathi satthā devamanussānaṁ buddho bhagavā’ti.","e":"‘That Blessed One is perfected, a fully awakened Buddha, accomplished in knowledge and conduct, holy, knower of the world, supreme guide for those fit for training, teacher of gods and humans, awakened, blessed.’","q":1,"s":"Vāseṭṭha","l":""},{"i":"mn98:5.5","p":"Āyāma, bho bhāradvāja, yena samaṇo gotamo tenupasaṅkamissāma; upasaṅkamitvā samaṇaṁ gotamaṁ etamatthaṁ pucchissāma.","e":"Come, let’s go to see him and ask him about this matter.","s":"Vāseṭṭha","l":""},{"i":"mn98:5.6","p":"Yathā no samaṇo gotamo byākarissati tathā naṁ dhāressāmā”ti.","e":"As he answers, so we’ll remember it.”","s":"Vāseṭṭha","l":""},{"i":"mn98:5.7","p":"“Evaṁ, bho”ti kho bhāradvājo māṇavo vāseṭṭhassa māṇavassa paccassosi.","e":"“Yes, worthy sir,” replied Bhāradvāja.","s":"Bhāradvāja","l":""},{"i":"mn98:6.1","p":"Atha kho vāseṭṭhabhāradvājā māṇavā yena bhagavā tenupasaṅkamiṁsu; upasaṅkamitvā bhagavatā saddhiṁ sammodiṁsu.","e":"So they went to the Buddha and exchanged greetings with him.","s":"N","l":""},{"i":"mn98:6.2","p":"Sammodanīyaṁ kathaṁ sāraṇīyaṁ vītisāretvā ekamantaṁ nisīdiṁsu.","e":"When the greetings and polite conversation were over, they sat down to one side,","s":"N","l":""},{"i":"mn98:6.3","p":"Ekamantaṁ nisinno kho vāseṭṭho māṇavo bhagavantaṁ gāthāhi ajjhabhāsi:","e":"and Vāseṭṭha addressed the Buddha in verse:","s":"N","l":""},{"i":"mn98:7.1","p":"“Anuññātapaṭiññātā,","e":"“We’re both authorized masters","s":"Vāseṭṭha","l":""},{"i":"mn98:7.2","p":"tevijjā mayamasmubho;","e":"of the three Vedas.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.3","p":"Ahaṁ pokkharasātissa,","e":"I’m a student of Pokkharasāti,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.4","p":"tārukkhassāyaṁ māṇavo.","e":"and he of Tārukkha.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.5","p":"Tevijjānaṁ yadakkhātaṁ,","e":"We’re fully qualified","s":"Vāseṭṭha","l":""},{"i":"mn98:7.6","p":"tatra kevalinosmase;","e":"in all the Vedic experts teach.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.7","p":"Padakasmā veyyākaraṇā,","e":"As philologists and grammarians,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.8","p":"jappe ācariyasādisā;","e":"we match our tutors in recitation.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.9","p":"Tesaṁ no jātivādasmiṁ,","e":"We have a dispute","s":"Vāseṭṭha","l":""},{"i":"mn98:7.10","p":"vivādo atthi gotama.","e":"regarding genealogy.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.11","p":"Jātiyā brāhmaṇo hoti,","e":"For Bhāradvāja says that","s":"Vāseṭṭha","l":""},{"i":"mn98:7.12","p":"bhāradvājo iti bhāsati;","e":"one is a brahmin due to birth,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.13","p":"Ahañca kammunā brūmi,","e":"but I declare it’s because of one’s deeds.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.14","p":"evaṁ jānāhi cakkhuma.","e":"Oh Clear-eyed One, know this as our debate.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.15","p":"Te na sakkoma ñāpetuṁ,","e":"Since neither of us was able","r":"sya13.643","s":"Vāseṭṭha","l":""},{"i":"mn98:7.16","p":"aññamaññaṁ mayaṁ ubho;","e":"to convince the other,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.17","p":"Bhavantaṁ puṭṭhumāgamā,","e":"we’ve come to ask you, sir,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.18","p":"sambuddhaṁ iti vissutaṁ.","e":"renowned as the awakened one.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.19","p":"Candaṁ yathā khayātītaṁ,","e":"As people honor with cupped palms","s":"Vāseṭṭha","l":""},{"i":"mn98:7.20","p":"pecca pañjalikā janā;","e":"the moon on the cusp of waxing,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.21","p":"Vandamānā namassanti,","e":"bowing, they revere","s":"Vāseṭṭha","l":""},{"i":"mn98:7.22","p":"lokasmiṁ gotamaṁ.","e":"Gotama in the world.","s":"Vāseṭṭha","l":""},{"i":"mn98:7.23","p":"Cakkhuṁ loke samuppannaṁ,","e":"We ask this of Gotama,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.24","p":"mayaṁ pucchāma gotamaṁ;","e":"the Eye arisen in the world:","s":"Vāseṭṭha","l":""},{"i":"mn98:7.25","p":"Jātiyā brāhmaṇo hoti,","e":"is one a brahmin due to birth,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.26","p":"udāhu bhavati kammunā;","e":"or else because of deeds?","s":"Vāseṭṭha","l":""},{"i":"mn98:7.27","p":"Ajānataṁ no pabrūhi,","e":"We don’t know, please tell us,","s":"Vāseṭṭha","l":""},{"i":"mn98:7.28","p":"yathā jānemu brāhmaṇan”ti.","e":"so we can recognize a brahmin.”","s":"Vāseṭṭha","l":""},{"i":"mn98:8.1","p":"“Tesaṁ vo ahaṁ byakkhissaṁ,","e":"“I shall explain to you,”","s":"B","l":"A"},{"i":"mn98:8.2","p":"(vāseṭṭhāti bhagavā)","e":"said the Buddha,","s":"B","l":"A"},{"i":"mn98:8.3","p":"Anupubbaṁ yathātathaṁ;","e":"“accurately and in sequence,","s":"B","l":"A"},{"i":"mn98:8.4","p":"Jātivibhaṅgaṁ pāṇānaṁ,","e":"the taxonomy of living creatures,","s":"B","l":"A"},{"i":"mn98:8.5","p":"Aññamaññāhi jātiyo.","e":"for species are indeed diverse.","s":"B","l":"A"},{"i":"mn98:8.6","p":"Tiṇarukkhepi jānātha,","e":"Know the grass and trees,","s":"B","l":"A"},{"i":"mn98:8.7","p":"na cāpi paṭijānare;","e":"though they lack self-awareness.","s":"B","l":"A"},{"i":"mn98:8.8","p":"Liṅgaṁ jātimayaṁ tesaṁ,","e":"They’re defined by birth,","s":"B","l":"A"},{"i":"mn98:8.9","p":"aññamaññā hi jātiyo.","e":"for species are indeed diverse.","s":"B","l":"A"},{"i":"mn98:8.10","p":"Tato kīṭe paṭaṅge ca,","e":"Next there are bugs that crawl or fly,","s":"B","l":"A"},{"i":"mn98:8.11","p":"yāva kunthakipillike;","e":"and so on, to ants and termites.","s":"B","l":"A"},{"i":"mn98:8.12","p":"Liṅgaṁ jātimayaṁ tesaṁ,","e":"They’re defined by birth,","s":"B","l":"A"},{"i":"mn98:8.13","p":"aññamaññā hi jātiyo.","e":"for species are indeed diverse.","s":"B","l":"A"},{"i":"mn98:8.14","p":"Catuppadepi jānātha,","e":"Know the quadrupeds, too,","s":"B","l":"A"},{"i":"mn98:8.15","p":"khuddake ca mahallake;","e":"both small and large.","s":"B","l":"A"},{"i":"mn98:8.16","p":"Liṅgaṁ jātimayaṁ tesaṁ,","e":"They’re defined by birth,","s":"B","l":"A"},{"i":"mn98:8.17","p":"aññamaññā hi jātiyo.","e":"for species are indeed diverse.","s":"B","l":"A"},{"i":"mn98:8.18","p":"Pādudarepi jānātha,","e":"Know, too, the long-backed snakes,","s":"B","l":"A"},{"i":"mn98:8.19","p":"urage dīghapiṭṭhike;","e":"crawling on their bellies.","s":"B","l":"A"},{"i":"mn98:8.20","p":"Liṅgaṁ jātimayaṁ tesaṁ,","e":"They’re defined by birth,","s":"B","l":"A"},{"i":"mn98:8.21","p":"aññamaññā hi jātiyo.","e":"for species are indeed diverse.","s":"B","l":"A"},{"i":"mn98:8.22","p":"Tato macchepi jānātha,","e":"Next know the fish,","s":"B","l":"A"},{"i":"mn98:8.23","p":"udake vārigocare;","e":"whose habitat is the water.","s":"B","l":"A"},{"i":"mn98:8.24","p":"Liṅgaṁ jātimayaṁ tesaṁ,","e":"They’re defined by birth,","s":"B","l":"A"},{"i":"mn98:8.25","p":"aññamaññā hi jātiyo.","e":"for species are indeed diverse.","r":"sya13.644","s":"B","l":"A"},{"i":"mn98:8.26","p":"Tato pakkhīpi jānātha,","e":"Next know the birds,","s":"B","l":"A"},{"i":"mn98:8.27","p":"pattayāne vihaṅgame;","e":"winged chariots in flight.","s":"B","l":"A"},{"i":"mn98:8.28","p":"Liṅgaṁ jātimayaṁ tesaṁ,","e":"They’re defined by birth,","s":"B","l":"A"},{"i":"mn98:8.29","p":"aññamaññā hi jātiyo.","e":"for species are indeed diverse.","s":"B","l":"A"},{"i":"mn98:9.1","p":"Yathā etāsu jātīsu,","e":"While the differences between these species","s":"B","l":"A"},{"i":"mn98:9.2","p":"liṅgaṁ jātimayaṁ puthu;","e":"are defined by birth,","s":"B","l":"A"},{"i":"mn98:9.3","p":"Evaṁ natthi manussesu,","e":"the differences between humans","s":"B","l":"A"},{"i":"mn98:9.4","p":"liṅgaṁ jātimayaṁ puthu.","e":"are not defined by birth.","s":"B","l":"A"},{"i":"mn98:9.5","p":"Na kesehi na sīsehi,","e":"Not by hair nor by head,","s":"B","l":"A"},{"i":"mn98:9.6","p":"na kaṇṇehi na akkhīhi;","e":"not by ear nor by eye,","s":"B","l":"A"},{"i":"mn98:9.7","p":"Na mukhena na nāsāya,","e":"not by mouth nor by nose,","s":"B","l":"A"},{"i":"mn98:9.8","p":"na oṭṭhehi bhamūhi vā.","e":"not by lips nor by eyebrow,","s":"B","l":"A"},{"i":"mn98:9.9","p":"Na gīvāya na aṁsehi,","e":"not by shoulder nor by neck,","s":"B","l":"A"},{"i":"mn98:9.10","p":"na udarena na piṭṭhiyā;","e":"not by belly nor by back,","s":"B","l":"A"},{"i":"mn98:9.11","p":"Na soṇiyā na urasā,","e":"not by buttocks nor by breast,","s":"B","l":"A"},{"i":"mn98:9.12","p":"na sambādhe na methune.","e":"not by groin nor by genitals,","s":"B","l":"A"},{"i":"mn98:9.13","p":"Na hatthehi na pādehi,","e":"not by hands nor by feet,","s":"B","l":"A"},{"i":"mn98:9.14","p":"naṅgulīhi nakhehi vā;","e":"not by fingers nor by nails,","s":"B","l":"A"},{"i":"mn98:9.15","p":"Na jaṅghāhi na ūrūhi,","e":"not by knees nor by thighs,","s":"B","l":"A"},{"i":"mn98:9.16","p":"na vaṇṇena sarena vā;","e":"not by color nor by voice:","s":"B","l":"A"},{"i":"mn98:9.17","p":"Liṅgaṁ jātimayaṁ neva,","e":"none of these are defined by birth","s":"B","l":"A"},{"i":"mn98:9.18","p":"yathā aññāsu jātisu.","e":"as it is for other species.","s":"B","l":"A"},{"i":"mn98:9.19","p":"Paccattañca sarīresu,","e":"In specific human bodies","s":"B","l":"A"},{"i":"mn98:9.20","p":"manussesvetaṁ na vijjati;","e":"you can’t find such distinctions.","s":"B","l":"A"},{"i":"mn98:9.21","p":"Vokārañca manussesu,","e":"The distinctions among humans","s":"B","l":"A"},{"i":"mn98:9.22","p":"samaññāya pavuccati.","e":"are spoken of by convention.","s":"B","l":"A"},{"i":"mn98:10.1","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.2","p":"gorakkhaṁ upajīvati;","e":"who lives off keeping cattle:","s":"B","l":"A"},{"i":"mn98:10.3","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.4","p":"kassako so na brāhmaṇo.","e":"as a farmer, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.5","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.6","p":"puthusippena jīvati;","e":"who lives off various professions:","s":"B","l":"A"},{"i":"mn98:10.7","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.8","p":"sippiko so na brāhmaṇo.","e":"as a professional, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.9","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.10","p":"vohāraṁ upajīvati;","e":"who lives off trade:","s":"B","l":"A"},{"i":"mn98:10.11","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.12","p":"vāṇijo so na brāhmaṇo.","e":"as a trader, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.13","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.14","p":"parapessena jīvati;","e":"who lives off serving others:","s":"B","l":"A"},{"i":"mn98:10.15","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.16","p":"pessako so na brāhmaṇo.","e":"as a servant, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.17","p":"Yo hi koci manussesu,","e":"Anyone among humans","r":"sya13.645","s":"B","l":"A"},{"i":"mn98:10.18","p":"adinnaṁ upajīvati;","e":"who lives off stealing:","s":"B","l":"A"},{"i":"mn98:10.19","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.20","p":"coro eso na brāhmaṇo.","e":"as a bandit, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.21","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.22","p":"issatthaṁ upajīvati;","e":"who lives off archery:","s":"B","l":"A"},{"i":"mn98:10.23","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.24","p":"yodhājīvo na brāhmaṇo.","e":"as a warrior, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.25","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.26","p":"porohiccena jīvati;","e":"who lives off priesthood:","s":"B","l":"A"},{"i":"mn98:10.27","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.28","p":"yājako so na brāhmaṇo.","e":"as a sacrificer, not a brahmin.","s":"B","l":"A"},{"i":"mn98:10.29","p":"Yo hi koci manussesu,","e":"Anyone among humans","s":"B","l":"A"},{"i":"mn98:10.30","p":"gāmaṁ raṭṭhañca bhuñjati;","e":"who taxes village and nation,","s":"B","l":"A"},{"i":"mn98:10.31","p":"Evaṁ vāseṭṭha jānāhi,","e":"know them, Vāseṭṭha,","s":"B","l":"A"},{"i":"mn98:10.32","p":"rājā eso na brāhmaṇo.","e":"as a ruler, not a brahmin.","s":"B","l":"A"},{"i":"mn98:11.1","p":"Na cāhaṁ brāhmaṇaṁ brūmi,","e":"I don’t call someone a brahmin","s":"B","l":"A"},{"i":"mn98:11.2","p":"yonijaṁ mattisambhavaṁ;","e":"after the mother’s womb they’re born from.","s":"B","l":"A"},{"i":"mn98:11.3","p":"Bhovādi nāma so hoti,","e":"If they still have attachments,","s":"B","l":"A"},{"i":"mn98:11.4","p":"sace hoti sakiñcano;","e":"they’re just someone who says ‘worthy’.","q":1,"s":"B","l":"A"},{"i":"mn98:11.5","p":"Akiñcanaṁ anādānaṁ,","e":"Having nothing, taking nothing:","s":"B","l":"A"},{"i":"mn98:11.6","p":"tamahaṁ brūmi brāhmaṇaṁ."